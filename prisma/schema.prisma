// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ERC20Token {
  id    Int     @id @default(autoincrement())
  contractAddress String
  owner String
  amount BigInt
}

model ERC20TokenTransferTx {
  id    Int     @id @default(autoincrement())
  contractAddress String
  tx String
  blockNumber Int
  paramFrom String
  paramTo String
  paramValue BigInt
}

model ERC721Token {
  id    Int     @id @default(autoincrement())
  contractAddress String
  owner String
  tokenId BigInt  @unique
}

model ERC721TokenTransferTx {
  id    Int     @id @default(autoincrement())
  contractAddress String
  tx String
  blockNumber Int
  paramFrom String
  paramTo String
  paramTokenId BigInt
}

model ERC1155Token {
  id    Int     @id @default(autoincrement())
  contractAddress String
  owner String
  tokenId BigInt
  tokenValue BigInt
}

model ERC1155TokenTransferSingleTx {
  id    Int     @id @default(autoincrement())
  contractAddress String
  tx String
  blockNumber Int
  paramOperator String
  paramFrom String
  paramTo String
  paramId BigInt
  paramValue BigInt
}

model ERC1155TokenTransferBatchTx {
  id    Int     @id @default(autoincrement())
  contractAddress String
  tx String
  blockNumber Int
  paramOperator String
  paramFrom String
  paramTo String
  paramIds String
  paramValues String
}

// --------------------------------------

model SNS {
  id    Int     @id @default(autoincrement())
  tokenId BigInt  @unique
  sns String @unique
  owner String
  registeredDate BigInt
  length Int
  segmentLength Int
  characterSet String
}

model SNSNameregisteredTx {
  id    Int     @id @default(autoincrement())
  tx String
  blockNumber Int
  paramName String
  paramOwner String
}

// SNSTransferTx saved at 'ERC721TokenTransferTx' table
