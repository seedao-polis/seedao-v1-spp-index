// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOT USED
model erc20Test {
  id    Int     @id @default(autoincrement())
  owner String
  amount BigInt
}

model erc20TestTransferTx {
  id    Int     @id @default(autoincrement())
  tx String @unique
  blockNumber Int
  paramFrom String
  paramTo String
  paramValue BigInt
}

// NOT USED
model scr {
  id    Int     @id @default(autoincrement())
  owner String
  amount BigInt
}

model scrTransferTx {
  id    Int     @id @default(autoincrement())
  tx String @unique
  blockNumber Int
  paramFrom String
  paramTo String
  paramValue BigInt
}

// NOT USED
model seed {
  id    Int     @id @default(autoincrement())
  owner String
  tokenId String  @unique
}

model seedTransferTx {
  id    Int     @id @default(autoincrement())
  tx String @unique
  blockNumber Int
  paramFrom String
  paramTo String
  paramTokenId String
}

model sns {
  id    Int     @id @default(autoincrement())
  tokenId String  @unique
  sns String @unique
  owner String
  registeredDate BigInt
  length Int
  segmentLength Int
  characterSet String
}

model snsNameregisteredTx {
  id    Int     @id @default(autoincrement())
  tx String @unique
  blockNumber Int
  paramName String
  paramOwner String
}

model snsTransferTx {
  id    Int     @id @default(autoincrement())
  tx String @unique
  blockNumber Int
  paramFrom String
  paramTo String
  paramTokenId String
}
