// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model sns {
  id    Int     @id @default(autoincrement())
  tokenId BigInt  @unique
  sns String @unique
  owner String
  blockNumber Int
}
