// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model ERC20Token {
  id    Int     @id @default(autoincrement())
  contractAddress String
  owner String
  amount Decimal
}

model ERC20TokenTransferTx {
  id    Int     @id @default(autoincrement())
  contractAddress String
  tx String
  blockNumber Int
  timestamp Int
  handler String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramFrom String
  paramTo String
  paramValue Decimal
}

model ERC721Token {
  id    Int     @id @default(autoincrement())
  contractAddress String
  owner String
  tokenId String  @unique
  timestamp Int
}

model ERC721TokenTransferTx {
  id    Int     @id @default(autoincrement())
  contractAddress String
  tx String
  blockNumber Int
  timestamp Int
  handler String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramFrom String
  paramTo String
  paramTokenId String
}

model ERC1155Token {
  id    Int     @id @default(autoincrement())
  contractAddress String
  owner String
  tokenId String
  tokenValue BigInt
}

model ERC1155TokenTransferSingleTx {
  id    Int     @id @default(autoincrement())
  contractAddress String
  tx String
  blockNumber Int
  timestamp Int
  handler String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramOperator String
  paramFrom String
  paramTo String
  paramId String
  paramValue BigInt
}

model ERC1155TokenTransferBatchTx {
  id    Int     @id @default(autoincrement())
  contractAddress String
  tx String
  blockNumber Int
  timestamp Int
  handler String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramOperator String
  paramFrom String
  paramTo String
  paramIds String
  paramValues String
}

// --------------------------------------

model SNS {
  id    Int     @id @default(autoincrement())
  tokenId String  @unique
  sns String @unique
  owner String
  registeredDate Int
  length Int
  segmentLength Int
  characterSet String
}

model SNSNameregisteredTx {
  id    Int     @id @default(autoincrement())
  tx String
  blockNumber Int
  timestamp Int
  handler String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramName String
  paramOwner String
}

// SNSTransferTx saved at 'ERC721TokenTransferTx' table

model SNSAddressResolver {
  id      Int    @id @default(autoincrement())
  node    String @unique
  address String
}

model SNSResolverAddrChangedTx {
  id          Int    @id @default(autoincrement())
  tx          String
  blockNumber Int
  timestamp   Int
  handler     String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramNode   String
  paramA      String
}

model SNSNameResolver {
  id   Int    @id @default(autoincrement())
  node String @unique
  name String
}

model SNSResolverNameChangedTx {
  id          Int    @id @default(autoincrement())
  tx          String
  blockNumber Int
  timestamp   Int
  handler     String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramNode   String
  paramName   String
}

// --------------------------------------

model ScoreLend {
  id                Int     @id @default(autoincrement())
  lendId            String  @unique
  lendStatus        Int
  debtor            String
  borrowToken       String
  borrowAmount      Decimal
  mortgageSCRAmount Decimal
  interestRate      Decimal // 0.0001
  borrowTimestamp   Int
  borrowTx          String
  overdueTimestamp  Int
  paybackTimestamp  Int
  paybackTx         String
  interestDays      Int
  interestAmount    Decimal
}

model ScoreLendBorrowTx {
  id                        Int     @id @default(autoincrement())
  tx                        String
  blockNumber               Int
  timestamp                 Int
  handler                   String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramId                   String
  paramDebtor               String
  paramBorrowToken          String
  paramBorrowAmount         Decimal
  paramMortgageSCRAmount    Decimal
  paramInterestRate         Int
  paramInterestRateDecimals Int
  paramBorrowTimestamp      Int
  paramOverdueTimestamp     Int
}

model ScoreLendPaybackTx {
  id                  Int     @id @default(autoincrement())
  tx                  String
  blockNumber         Int
  timestamp           Int
  handler             String // `query`: `Contract.queryFilter(...)`, `on`: `Contract.on(...)`
  paramId             String
  paramInterestDays   Int
  paramInterestAmount Decimal
}
